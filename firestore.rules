rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny by Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isCitizen() {
      return isRole('citizen');
    }

    function isOfficer() {
      return isRole('officer') || isRole('field_officer');
    }

    function isAdmin() {
      return isRole('admin') || isRole('commissioner');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOfficer() || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Potholes Collection (Consolidated Master)
    match /potholes/{potholeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0 &&
        request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0 &&
        request.resource.data.severity in ['low', 'medium', 'high'] &&
        request.resource.data.status in ['detected', 'verified', 'assigned', 'repaired'];
      allow update: if isOfficer() || isAdmin() || (
        isCitizen() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmations', 'updated_at'])
      );
      allow delete: if isAdmin();
    }

    // Raw Reports Collection
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.reporter_id == request.auth.uid || isOfficer() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.reporter_id == request.auth.uid;
      allow update: if isOfficer() || isAdmin();
      allow delete: if isAdmin();
    }

    // Wards Boundary Collection
    match /wards/{wardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // System Config Collection (Thresholds & SLAs)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isOfficer() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit logs
    }
  }
}
